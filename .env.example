# Valores públicos do Firebase Web SDK para o projeto de desenvolvimento fornecido pela ISP.
# Não incluir service account, chave privada, token ou segredo neste arquivo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=default
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set true only when the Firebase Emulator Suite is running locally.
VITE_USE_FIREBASE_EMULATORS=false
